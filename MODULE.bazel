module(name = "java-game")

bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_jvm_external", version = "6.6")
bazel_dep(name = "rules_scala", version = "7.0.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")

# JavaFX is a jar per platform, each with the classes and that platform's natives (the plain
# artifacts are empty). Their POM makes every one of them depend on the jar for the machine doing
# the build, so each is listed here with the rest of JavaFX excluded: without that, a Windows build
# made on a Mac carried the Mac jars, ahead of its own on the classpath (third_party/jvm.bzl).
JAVAFX_ONLY_ITSELF = [
    "org.openjfx:javafx-base",
    "org.openjfx:javafx-controls",
    "org.openjfx:javafx-graphics",
]

maven.artifact(artifact = "javafx-base", classifier = "mac-aarch64", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")
maven.artifact(artifact = "javafx-controls", classifier = "mac-aarch64", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")
maven.artifact(artifact = "javafx-graphics", classifier = "mac-aarch64", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")
maven.artifact(artifact = "javafx-base", classifier = "win", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")
maven.artifact(artifact = "javafx-controls", classifier = "win", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")
maven.artifact(artifact = "javafx-graphics", classifier = "win", exclusions = JAVAFX_ONLY_ITSELF, group = "org.openjfx", version = "21.0.1")

maven.install(
    artifacts = [
        "com.google.guava:guava:32.1.3-jre",
        "com.google.code.gson:gson:2.10.1",
        "io.netty:netty-buffer:4.1.104.Final",
        "io.netty:netty-codec:4.1.104.Final",
        "io.netty:netty-common:4.1.104.Final",
        "io.netty:netty-handler:4.1.104.Final",
        "io.netty:netty-transport:4.1.104.Final",
        "io.netty:netty-transport-native-unix-common:4.1.104.Final",
        "junit:junit:4.13.2",
        "org.xerial:sqlite-jdbc:3.44.0.0",
        "org.mindrot:jbcrypt:0.4",
        "org.lwjgl:lwjgl:3.3.4",
        "org.lwjgl:lwjgl-glfw:3.3.4",
        "org.lwjgl:lwjgl:jar:natives-macos-arm64:3.3.4",
        "org.lwjgl:lwjgl-glfw:jar:natives-macos-arm64:3.3.4",
        "org.lwjgl:lwjgl-opengl:3.3.4",
        "org.lwjgl:lwjgl-opengl:jar:natives-macos-arm64:3.3.4",
        "org.lwjgl:lwjgl-stb:3.3.4",
        "org.lwjgl:lwjgl-stb:jar:natives-macos-arm64:3.3.4",
        # Windows LWJGL native libraries
        "org.lwjgl:lwjgl:jar:natives-windows:3.3.4",
        "org.lwjgl:lwjgl-glfw:jar:natives-windows:3.3.4",
        "org.lwjgl:lwjgl-opengl:jar:natives-windows:3.3.4",
        "org.lwjgl:lwjgl-stb:jar:natives-windows:3.3.4",
        # OpenTelemetry — observability (metrics, traces, logs)
        "io.opentelemetry:opentelemetry-api:1.42.1",
        "io.opentelemetry:opentelemetry-context:1.42.1",
        "io.opentelemetry:opentelemetry-sdk:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-common:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-metrics:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-trace:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-logs:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-extension-autoconfigure:1.42.1",
        "io.opentelemetry:opentelemetry-sdk-extension-autoconfigure-spi:1.42.1",
        "io.opentelemetry:opentelemetry-exporter-otlp:1.42.1",
        "io.opentelemetry:opentelemetry-exporter-otlp-common:1.42.1",
        "io.opentelemetry:opentelemetry-exporter-common:1.42.1",
        "io.opentelemetry:opentelemetry-exporter-sender-okhttp:1.42.1",
        "io.opentelemetry:opentelemetry-exporter-logging:1.42.1",
        "io.opentelemetry.semconv:opentelemetry-semconv:1.27.0-alpha",
        "io.opentelemetry.instrumentation:opentelemetry-runtime-telemetry-java17:2.8.0-alpha",
        "io.opentelemetry.instrumentation:opentelemetry-instrumentation-api:2.8.0",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    fetch_sources = True,
    duplicate_version_warning = "none",
)
use_repo(maven, "maven")

# Scala toolchain configuration
scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = "2.13.16")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
scala_deps.junit()

scala_toolchains = use_extension(
    "@rules_scala//scala/extensions:toolchains.bzl",
    "scala_toolchains",
)
scala_toolchains.testing()
