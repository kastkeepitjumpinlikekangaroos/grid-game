load("@rules_scala//scala:scala.bzl", "scala_junit_test")

# One target per file, so each test runs in a JVM of its own
[scala_junit_test(
    name = name,
    srcs = [src],
    data = data,
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/gridgame/common",
        "@maven//:junit_junit",
    ],
) for (name, src, data) in [
    ("position_test", "PositionTest.scala", []),
    ("match_results_test", "MatchResultsTest.scala", []),
    ("team_divider_test", "TeamDividerTest.scala", []),
    ("team_assignment_test", "TeamAssignmentTest.scala", []),
    ("projectile_terrain_test", "ProjectileTerrainTest.scala", []),
    ("fan_projectile_test", "FanProjectileTest.scala", []),
    ("movement_test", "MovementTest.scala", []),
    ("teleport_test", "TeleportTest.scala", []),
    # Alone in its JVM: it checks the first projectile lookup, before anything touches CharacterDef
    ("projectile_def_registry_test", "ProjectileDefRegistryTest.scala", []),
    ("projectile_hit_test", "ProjectileHitTest.scala", []),
    ("player_test", "PlayerTest.scala", []),
    ("knockback_test", "KnockbackTest.scala", []),
    ("character_roster_test", "CharacterRosterTest.scala", ["//sprites:sprite_files"]),
    ("world_data_test", "WorldDataTest.scala", []),
    ("barrier_test", "BarrierTest.scala", []),
    ("roster_balance_test", "RosterBalanceTest.scala", []),
    ("melee_kit_test", "MeleeKitTest.scala", []),
    ("tile_test", "TileTest.scala", ["//sprites:sprite_files"]),
]]
