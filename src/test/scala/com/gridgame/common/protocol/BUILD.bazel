load("@rules_scala//scala:scala.bzl", "scala_junit_test")

# One target per file, so each test runs in a JVM of its own
[scala_junit_test(
    name = name,
    srcs = [src],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/gridgame/common",
        "@maven//:junit_junit",
    ],
) for (name, src) in [
    ("packet_round_trip_test", "PacketRoundTripTest.scala"),
    ("packet_signer_test", "PacketSignerTest.scala"),
    ("auth_rules_test", "AuthRulesTest.scala"),
]]
