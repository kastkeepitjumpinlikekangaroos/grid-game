load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")
load("//third_party:jvm.bzl", "NETTY")

# Drives a match by hand for the tests below: ticks on demand, every packet each player is sent
scala_library(
    name = "server_test_kit",
    testonly = True,
    srcs = ["ServerTestKit.scala"],
    deps = [
        "//src/main/scala/com/gridgame/common",
        "//src/main/scala/com/gridgame/server:server_lib",
    ] + NETTY,
)

# One target per file, so each test runs in a JVM of its own
[scala_junit_test(
    name = name,
    srcs = [src],
    data = data,
    suffixes = ["Test"],
    deps = [
        ":server_test_kit",
        "//src/main/scala/com/gridgame/common",
        "//src/main/scala/com/gridgame/server:server_lib",
        "@maven//:junit_junit",
    ] + NETTY,
) for (name, src, data) in [
    ("teleport_validation_test", "TeleportValidationTest.scala", []),
    ("ability_cast_validation_test", "AbilityCastValidationTest.scala", []),
    # What tick each projectile packet says it is from, which clients fly projectiles by
    ("projectile_ticks_test", "ProjectileTicksTest.scala", []),
    ("ceasefire_test", "CeasefireTest.scala", []),
    ("team_divider_test", "TeamDividerTest.scala", []),
    ("combat_test", "CombatTest.scala", []),
    ("on_hit_effects_test", "OnHitEffectsTest.scala", []),
    ("position_authority_test", "PositionAuthorityTest.scala", []),
    ("respawn_test", "RespawnTest.scala", []),
    ("player_relay_test", "PlayerRelayTest.scala", []),
    ("phase_shift_test", "PhaseShiftTest.scala", []),
    ("item_test", "ItemTest.scala", []),
    ("session_test", "SessionTest.scala", []),
    ("packet_validator_test", "PacketValidatorTest.scala", []),
    ("auth_database_test", "AuthDatabaseTest.scala", []),
    ("auth_flow_test", "AuthFlowTest.scala", []),
    ("end_game_test", "EndGameTest.scala", []),
    ("lobby_flow_test", "LobbyFlowTest.scala", ["//worlds:world_files"]),
    ("trap_test", "TrapTest.scala", []),
    ("barrier_test", "BarrierTest.scala", []),
    ("bot_movement_test", "BotMovementTest.scala", []),
    ("melee_kits_test", "MeleeKitsTest.scala", []),
    ("network_handler_test", "NetworkHandlerTest.scala", []),
    ("reconnect_test", "ReconnectTest.scala", []),
    ("spawn_request_test", "SpawnRequestTest.scala", []),
    ("ranked_queue_test", "RankedQueueTest.scala", ["//worlds:world_files"]),
    ("chat_test", "ChatTest.scala", []),
    ("rate_limiter_test", "RateLimiterTest.scala", []),
    ("lobby_manager_test", "LobbyManagerTest.scala", []),
]]
