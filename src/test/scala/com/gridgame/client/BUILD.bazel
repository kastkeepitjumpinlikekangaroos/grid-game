load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")
load("//third_party:jvm.bzl", "NETTY")

# A GameClient with no network (its packets captured) and a JavaFX helper, for the tests here
scala_library(
    name = "client_test_kit",
    testonly = True,
    srcs = ["ClientTestKit.scala"],
    visibility = ["//src/test/scala/com/gridgame/client:__subpackages__"],
    deps = [
        "//src/main/scala/com/gridgame/client:client_lib",
        "//src/main/scala/com/gridgame/common",
    ],
)

CLIENT_TEST_DEPS = [
    ":client_test_kit",
    "//src/main/scala/com/gridgame/client:client_lib",
    "//src/main/scala/com/gridgame/common",
    "@maven//:junit_junit",
]

# No sound device in a test: every AudioManager call is a no-op
AUDIO_OFF = {"GRIDGAME_AUDIO": "off"}

[scala_junit_test(
    name = name,
    srcs = [src],
    env = AUDIO_OFF,
    suffixes = ["Test"],
    deps = CLIENT_TEST_DEPS,
) for (name, src) in [
    ("game_client_match_test", "GameClientMatchTest.scala"),
    ("game_client_position_test", "GameClientPositionTest.scala"),
    ("game_client_combat_test", "GameClientCombatTest.scala"),
    ("game_client_blast_test", "GameClientBlastTest.scala"),
    ("game_client_status_test", "GameClientStatusTest.scala"),
    ("game_client_barrier_test", "GameClientBarrierTest.scala"),
    ("game_client_trap_test", "GameClientTrapTest.scala"),
    ("game_client_opening_test", "GameClientOpeningTest.scala"),
    ("game_client_lobby_test", "GameClientLobbyTest.scala"),
    ("game_client_spawn_requests_test", "GameClientSpawnRequestsTest.scala"),
    ("game_client_knockback_test", "GameClientKnockbackTest.scala"),
    # Casting mode: Q or E aimed and cast by a click, what goes off at once, and what is shown is cast
    ("game_client_aim_test", "GameClientAimTest.scala"),
    # R: both abilities ready again from the press, its own minute from the match's start, a refusal undone
    ("game_client_reset_test", "GameClientResetTest.scala"),
    ("projectile_flight_test", "ProjectileFlightTest.scala"),
    ("projectile_thrower_test", "ProjectileThrowerTest.scala"),
    ("lobby_room_screen_test", "LobbyRoomScreenTest.scala"),
    # The login screen: the form and Remember me, the saved login's card, another account
    ("welcome_screen_test", "WelcomeScreenTest.scala"),
    # Logging in with a refresh token, and out: what the client sends, and the order it hears in
    ("game_client_login_test", "GameClientLoginTest.scala"),
    # The app logging in and staying logged in: what it keeps, when it logs back in by itself
    ("client_login_flow_test", "ClientLoginFlowTest.scala"),
    ("scoreboard_screen_test", "ScoreboardScreenTest.scala"),
    # A problem report from the client's side: the match named, the snapshot of us, asking the server
    # and hearing its answer, the outbox told what became of it
    ("game_client_reports_test", "GameClientReportsTest.scala"),
    # The report's card: what it asks and shows, sending it, what it says when it went and when it didn't
    ("report_dialog_test", "ReportDialogTest.scala"),
    # Thousands of server packets at random, the player acting and frames drawn between: nothing throws
    ("client_packet_fuzz_test", "ClientPacketFuzzTest.scala"),
]]

# The client's network handlers, fed through an EmbeddedChannel
scala_junit_test(
    name = "client_network_test",
    srcs = ["ClientNetworkTest.scala"],
    env = AUDIO_OFF,
    suffixes = ["Test"],
    deps = CLIENT_TEST_DEPS + NETTY,
)

# The client holding a server to the identity it met there before: real TLS over loopback
scala_junit_test(
    name = "server_pinning_test",
    srcs = ["ServerPinningTest.scala"],
    env = AUDIO_OFF,
    suffixes = ["Test"],
    deps = CLIENT_TEST_DEPS + NETTY,
)

# A problem report's recording played into a client, with no window (devtools ReplaySession, what
# report_replay draws): to a time, as the packets and frames up to it say, and back to it again
scala_junit_test(
    name = "replay_session_test",
    srcs = ["ReplaySessionTest.scala"],
    env = AUDIO_OFF,
    suffixes = ["Test"],
    deps = CLIENT_TEST_DEPS + ["//src/main/scala/com/gridgame/client/devtools:replay"],
)
