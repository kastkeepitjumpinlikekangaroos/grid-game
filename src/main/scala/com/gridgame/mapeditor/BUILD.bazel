load("@rules_scala//scala:scala.bzl", "scala_binary", "scala_library")
load("//third_party:jvm.bzl", "GSON", "JAVAFX")

# The map editor: its own app, sharing only common (the model and the world loader) with the game.
scala_library(
    name = "mapeditor_lib",
    srcs = glob(["**/*.scala"]),
    deps = ["//src/main/scala/com/gridgame/common"] + GSON + JAVAFX,
)

scala_binary(
    name = "mapeditor",
    main_class = "com.gridgame.mapeditor.Main",
    resources = ["//sprites:sprite_files"],
    jvm_flags = [
        "-Xdock:name='Grid Game Map Editor'",
        "-Dapple.awt.application.name='Grid Game Map Editor'",
    ],
    deps = [
        ":mapeditor_lib",
        "@maven//:org_openjfx_javafx_base_mac_aarch64",
        "@maven//:org_openjfx_javafx_controls_mac_aarch64",
        "@maven//:org_openjfx_javafx_graphics_mac_aarch64",
    ],
)

scala_binary(
    name = "mapeditor_windows",
    main_class = "com.gridgame.mapeditor.Main",
    resources = ["//sprites:sprite_files"],
    deps = [
        ":mapeditor_lib",
        "@maven//:org_openjfx_javafx_base_win",
        "@maven//:org_openjfx_javafx_controls_win",
        "@maven//:org_openjfx_javafx_graphics_win",
    ],
)
