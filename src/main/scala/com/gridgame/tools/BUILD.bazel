load("@rules_scala//scala:scala.bzl", "scala_binary", "scala_library")

# Dev tool for regenerating the English game-content i18n catalog. Not shipped.
scala_binary(
    name = "gencontent",
    srcs = ["GenContentCatalog.scala"],
    main_class = "com.gridgame.tools.GenContentCatalog",
    deps = [
        "//src/main/scala/com/gridgame/common",
        "@maven//:com_google_code_gson_gson",
    ],
)

# The website's character cards, written from the roster (also read by the test that keeps them so)
scala_library(
    name = "docs_roster",
    srcs = ["DocsRoster.scala"],
    visibility = ["//src/test:__subpackages__"],
    deps = ["//src/main/scala/com/gridgame/common"],
)

# Dev tool for rewriting those cards in docs/index.html. Not shipped.
scala_binary(
    name = "gendocs",
    srcs = ["GenDocsRoster.scala"],
    main_class = "com.gridgame.tools.GenDocsRoster",
    deps = [":docs_roster"],
)

# A player's problem report read for a developer: what they said, their machine, and the match's
# recording as a timeline, tables and the connection's numbers (ReportTool; design/diagnostics.md).
scala_library(
    name = "report_tool",
    srcs = [
        "ReportFiles.scala",
        "ReportFrames.scala",
        "ReportPackets.scala",
        "ReportRecording.scala",
        "ReportSummary.scala",
        "ReportTables.scala",
        "ReportTimeline.scala",
        "ReportTool.scala",
    ],
    visibility = ["//src/test:__subpackages__"],
    deps = [
        "//src/main/scala/com/gridgame/common",
        "@maven//:com_google_code_gson_gson",
    ],
)

# Dev tool: bazel run //src/main/scala/com/gridgame/tools:report -- <report folder or zip>. Not shipped.
scala_binary(
    name = "report",
    main_class = "com.gridgame.tools.ReportTool",
    # A long match's recording is a million records or so, all held to be put in time order; the
    # contact sheets are drawn with Java2D, which needs no display
    jvm_flags = [
        "-Xmx2g",
        "-Djava.awt.headless=true",
    ],
    deps = [":report_tool"],
)
