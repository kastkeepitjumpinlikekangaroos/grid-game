load("@rules_scala//scala:scala.bzl", "scala_library")

# The layer the server, the client and the tools share. Each package under here is a library of its
# own, and depends only on the ones before it:
#
#   core (Constants, WorldRegistry)  <-  model  <-  protocol  <-  observability
#                                          ^
#                                          +------  world
#
# `common` is all of it, which is what almost everything depends on.
scala_library(
    name = "common",
    visibility = ["//visibility:public"],
    exports = [
        ":core",
        "//src/main/scala/com/gridgame/common/model",
        "//src/main/scala/com/gridgame/common/observability",
        "//src/main/scala/com/gridgame/common/protocol",
        "//src/main/scala/com/gridgame/common/world",
    ],
)

scala_library(
    name = "core",
    srcs = [
        "Constants.scala",
        "WorldRegistry.scala",
    ],
    visibility = ["//visibility:public"],
)
