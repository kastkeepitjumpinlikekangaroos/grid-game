load("@rules_scala//scala:scala.bzl", "scala_library")
load("//src/main/scala/com/gridgame/client:jars.bzl", "CLIENT")
load("//third_party:jvm.bzl", "LWJGL")

# The painters of the world: each part of the frame in world space (see GLGameRenderer).
scala_library(
    name = "world",
    srcs = glob(["*.scala"]),
    visibility = CLIENT,
    deps = [
        "//src/main/scala/com/gridgame/client/game",
        "//src/main/scala/com/gridgame/client/gl",
        "//src/main/scala/com/gridgame/client/i18n",
        "//src/main/scala/com/gridgame/client/render:core",
        "//src/main/scala/com/gridgame/client/render/blasts",
        "//src/main/scala/com/gridgame/client/render/projectiles",
        "//src/main/scala/com/gridgame/common",
    ] + LWJGL,
)
