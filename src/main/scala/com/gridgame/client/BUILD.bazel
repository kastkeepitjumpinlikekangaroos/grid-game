    "@maven//:org_lwjgl_lwjgl_stb_natives_macos_arm64",
]

scala_binary(
    name = "client",
    main_class = "com.gridgame.client.Main",
    srcs = glob(["**/*.scala"]),
    resources = CLIENT_RESOURCES,
    # Heap: start small and stop at 768MB rather than the JVM's default of a quarter of RAM.
    # The live set is well under 100MB; the rest of the heap tuning (giving memory back when
    # idle) is set at runtime in ClientMain.tuneHeap so it also applies to java -jar.
    # Keep in step with the Java options in scripts/build_macos_app.sh and
    # scripts/build_windows_exe.ps1, which is where the packaged apps get them.
    jvm_flags = [
        "-Xdock:name='Grid Game'",
        "-Dapple.awt.application.name='Grid Game'",
        "-Xms64m",
        "-Xmx768m",
    ],
    deps = CLIENT_DEPS,
)

# The same sources as a library, so tests can drive GameClient and the UI code directly.
scala_library(
    name = "client_lib",
    srcs = glob(["**/*.scala"]),
    resources = CLIENT_RESOURCES,
    visibility = ["//src/test/scala/com/gridgame/client:__subpackages__"],
    deps = CLIENT_DEPS,
)

