# Dev tool: renders every projectile type to contact-sheet PNGs for visual review.
# Not shipped. `srcs` names the handful of GL files the gallery needs instead of globbing
# the whole client, so projectile art work never waits on unrelated client code that
# happens to be mid-edit.
scala_binary(
    name = "projectile_gallery",
    main_class = "com.gridgame.client.gl.ProjectileGallery",
    srcs = [
        "gl/GLFWManager.scala",
        "gl/GLProjectileRenderers.scala",
        "gl/GLTexture.scala",
        "gl/Matrix4.scala",
        "gl/PostProcessor.scala",
        "gl/ProjectileGallery.scala",
        "gl/RenderQuality.scala",
        "gl/ShaderProgram.scala",
        "gl/ShapeBatch.scala",
        "gl/TextureRegion.scala",
    ],
    jvm_flags = ["-XstartOnFirstThread", "-Djava.awt.headless=true"],
    deps = [
        "//src/main/scala/com/gridgame/common",
        "@maven//:org_lwjgl_lwjgl",
        "@maven//:org_lwjgl_lwjgl_glfw",
        "@maven//:org_lwjgl_lwjgl_opengl",
        "@maven//:org_lwjgl_lwjgl_stb",
        "@maven//:org_lwjgl_lwjgl_natives_macos_arm64",
        "@maven//:org_lwjgl_lwjgl_glfw_natives_macos_arm64",
        "@maven//:org_lwjgl_lwjgl_opengl_natives_macos_arm64",
        "@maven//:org_lwjgl_lwjgl_stb_natives_macos_arm64",
