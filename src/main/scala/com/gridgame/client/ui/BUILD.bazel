load("@rules_scala//scala:scala.bzl", "scala_library")
load("//src/main/scala/com/gridgame/client:jars.bzl", "CLIENT")
load("//third_party:jvm.bzl", "JAVAFX")

# The menus' look and widgets: the Theme and its stylesheet, the widgets and the sky behind every
# screen, the character panel and its previews, sprite sheets.
scala_library(
    name = "ui",
    srcs = glob(["*.scala"]),
    # theme.css lands beside Theme's class, as com/gridgame/client/ui/theme.css
    resource_strip_prefix = "src/main/scala",
    resources = ["theme.css"],
    visibility = CLIENT,
    deps = [
        "//src/main/scala/com/gridgame/client/audio",
        "//src/main/scala/com/gridgame/client/i18n",
        "//src/main/scala/com/gridgame/common",
    ] + JAVAFX,
)
